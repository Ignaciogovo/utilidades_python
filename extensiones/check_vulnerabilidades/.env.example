# Imágenes que se analizarán.
# TODAS: usa todas las imágenes que cumplan SOLO_EN_USO e INCLUIR_DANGLING.
# También puedes indicar una lista separada por comas o patrones simples:
# IMAGENES=*immich*,neosmemo/memos:stable
IMAGENES=TODAS

# Carpeta interna donde se escriben los JSON compatibles con error_system.
# Debe coincidir con el destino del volumen de notificaciones en compose.yaml.
CARPETA_ERRORES=/app/notificaciones

# Fichero interno del log de control del escáner.
# Sus mensajes se guardan en la carpeta indicada por RUTA_LOGS_HOST.
RUTA_CONTROL=/app/logs/control.log

# Carpeta interna para las rotaciones antiguas de RUTA_CONTROL.
LOG_HISTORICO_DIR=/app/logs/historico

# Prefijo usado en el nombre del log y de los JSON generados.
LOG_PREFIJO=docker_vulnerabilidades

# Valor del campo "origen" dentro de cada JSON de notificación.
PROYECTO=docker_vulnerabilidades

# Ruta del servidor que se monta como CARPETA_ERRORES.
# Debe ser la misma carpeta que consume enviar_notificaciones.
RUTA_NOTIFICACIONES_HOST=/srv/notificaciones

# Ruta del servidor que se monta como /app/logs.
RUTA_LOGS_HOST=/srv/logs

# Carpeta del servidor donde se conserva el estado anti-repetición.
# No la borres salvo que quieras recibir de nuevo los avisos ya enviados.
RUTA_ESTADO_HOST=/srv/docker-vulnerabilidades

# Fichero interno donde se guardan ImageID, CVE, paquete y versión ya avisados.
ESTADO_FILE=/app/estado/estado.json

# Severidades que Trivy incluirá en el análisis.
# Valores habituales: UNKNOWN,LOW,MEDIUM,HIGH,CRITICAL.
SEVERIDADES=HIGH,CRITICAL

# 1: oculta vulnerabilidades para las que Trivy no conoce un parche.
# 0: también muestra vulnerabilidades sin versión corregida.
IGNORAR_SIN_CORREGIR=1

# 0: excluye imágenes sin etiqueta (<none>), recomendado.
# 1: incluye también imágenes huérfanas o intermedias.
INCLUIR_DANGLING=0

# 1: analiza solo imágenes usadas por contenedores activos, recomendado.
# 0: analiza todas las imágenes locales con etiqueta.
SOLO_EN_USO=1

# 0: SOLO_EN_USO considera únicamente contenedores activos.
# 1: también considera contenedores detenidos y sus imágenes.
INCLUIR_DETENIDOS=0
